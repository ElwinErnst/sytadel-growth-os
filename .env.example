# ---------------------------------------------------------------------------
# Sytadel Growth OS — environment template.
# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# No real credentials belong in this file or in git history.
# ---------------------------------------------------------------------------

# --- PostgreSQL (matches docker-compose.yml) -------------------------------
DB_HOST=localhost
DB_PORT=5440
DB_USER=growth
DB_PASS=growth-dev-insecure
DB_NAME=growth_os

# --- LLM provider ----------------------------------------------------------
# Which provider the workflow uses. `anthropic` = real API (needs a key).
# `fixture` = deterministic canned responses (used by tests and offline demos).
GROWTH_LLM_PROVIDER=anthropic

# Anthropic API key. Leave empty to run the `fixture` provider only.
# Secrets live here (git-ignored) — never in prompts, logs, or source.
ANTHROPIC_API_KEY=

# Model + generation limits (deterministic guardrails around the model call).
GROWTH_LLM_MODEL=claude-sonnet-5
GROWTH_LLM_MAX_TOKENS=2048
GROWTH_LLM_TIMEOUT_MS=60000
GROWTH_LLM_MAX_RETRIES=2

# Per-run hard ceiling on total tokens (input+output). Run fails if exceeded.
GROWTH_RUN_TOKEN_BUDGET=20000

# --- Web fetch (Slice 3a) --------------------------------------------------
# Read-only HTTP(S) fetch is guarded by SSRF controls (private/loopback/
# link-local/metadata IPs are always blocked; connections are pinned to the
# validated IP). These bound each fetch.
GROWTH_FETCH_MAX_REDIRECTS=5
GROWTH_FETCH_MAX_BYTES=2000000
GROWTH_FETCH_TIMEOUT_MS=15000
